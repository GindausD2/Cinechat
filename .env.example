# Copy to .env, replace every placeholder; never commit secrets.
DATABASE_URL=postgresql://cinechat:local-development-only@localhost:5432/cinechat?schema=public
POSTGRES_PASSWORD=local-development-only
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
WS_PORT=3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
REALTIME_SECRET=replace-with-a-different-32-character-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMTP_URL=
EMAIL_FROM=CineChat <hello@example.com>
# Local outbox only in non-production, never an HTTP-accessible directory.
EMAIL_DEV_OUTBOX=true
REGION_DEFAULT=US
# Required trusted CDN hostnames; no arbitrary user media URL is accepted.
MEDIA_ALLOWED_HOSTS=download.blender.org,localhost
# Enable only for the local sample delivery service, remove localhost for launch.
ALLOW_LOCAL_MEDIA=false
MEDIA_PORT=3002
# Optional signed S3/CloudFront media URLs supplied by your rights administrator.
MEDIA_SIGNING_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
MEDIA_CDN_BASE_URL=
# Stripe TEST keys only until launch approval. Live keys are always rejected in V1.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
BILLING_ENABLED=false
# Comma-separated emails: initial admin account is assigned during registration.
ADMIN_EMAILS=
HEALTH_TOKEN=
