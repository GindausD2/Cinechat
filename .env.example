# Copy to .env, replace every placeholder; never commit secrets.
DATABASE_URL=postgresql://cinechat:local-development-only@localhost:5432/cinechat?schema=public
POSTGRES_PASSWORD=local-development-only
REDIS_URL=redis://localhost:6379
# Maximum connections per web/realtime process; budget across all replicas.
DATABASE_POOL_SIZE=10
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
WS_PORT=3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
REALTIME_SECRET=replace-with-a-different-32-character-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMTP_URL=
EMAIL_FROM=CineChat <hello@example.com>
# Local outbox only in non-production, never an HTTP-accessible directory.
EMAIL_DEV_OUTBOX=true
REGION_DEFAULT=US
# Optional trusted proxy country header. Configure only if the proxy overwrites it
# and the origin cannot be reached directly; arbitrary client headers are unsafe.
TRUSTED_COUNTRY_HEADER=
# Required trusted CDN hostnames; no arbitrary user media URL is accepted.
MEDIA_ALLOWED_HOSTS=download.blender.org,localhost
# Enable only for the local sample delivery service, remove localhost for launch.
ALLOW_LOCAL_MEDIA=false
MEDIA_PORT=3002
# Optional signed S3/CloudFront media URLs supplied by your rights administrator.
MEDIA_SIGNING_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
MEDIA_CDN_BASE_URL=
# Payments are hard disabled in this free version, regardless of legacy settings.
# No payment-provider credentials are needed. Legacy database records are retained.
# Comma-separated emails: initial admin account is assigned during registration.
ADMIN_EMAILS=
HEALTH_TOKEN=
