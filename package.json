{
  "name": "cinechat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"next dev --hostname 0.0.0.0\" \"tsx watch realtime/server.ts\" \"tsx scripts/media-server.ts\"",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:realtime": "tsx watch realtime/server.ts",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "start:realtime": "tsx realtime/server.ts",
    "media:setup": "sh scripts/setup-media.sh",
    "media:hls-fixture": "sh scripts/setup-hls-fixture.sh",
    "media:serve": "tsx scripts/media-server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "infra:up": "docker compose up -d postgres redis",
    "reminders": "tsx scripts/reminders.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup:local": "node scripts/setup-local.mjs",
    "media:upload": "tsx scripts/upload-media.ts",
    "check:production": "node scripts/check-production.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@prisma/client": "^6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "cinechat-mailer": "npm:nodemailer@^10.1.1",
    "dotenv": "^17.2.3",
    "hls.js": "^1.6.13",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.577.0",
    "motion": "^12.23.26",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^20.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/smtp-server": "^3.5.13",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prisma": "^6.19.0",
    "smtp-server": "^3.19.22",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "deepmerge-ts": "^8.0.2"
  }
}
