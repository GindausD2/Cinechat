generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum MembershipRole {
  HOST
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
  BANNED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id                String              @id @default(cuid())
  name              String?
  email             String              @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  role              Role                @default(USER)
  authVersion       Int                 @default(0)
  suspended         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  accounts          Account[]
  sessions          Session[]
  profile           Profile?
  watchlist         Watchlist[]
  history           WatchHistory[]
  rooms             CinemaRoom[]
  memberships       RoomMembership[]
  invitations       Invitation[]
  messages          ChatMessage[]
  reactions         Reaction[]
  following         Follow[]            @relation("Following")
  followers         Follow[]            @relation("Followers")
  friendsSent       Friendship[]        @relation("Sent")
  friendsReceived   Friendship[]        @relation("Received")
  blocks            Block[]             @relation("Blocker")
  blockedBy         Block[]             @relation("Blocked")
  clubMemberships   ClubMembership[]
  clubs             MovieClub[]
  notifications     Notification[] @relation("NotificationRecipient")
  notificationsCreated Notification[] @relation("NotificationActor")
  reports           Report[]
  moderationActions ModerationAction[]
  subscription      Subscription?
  payments          Payment[]
  tokens            AuthToken[]
  tickets           RealtimeTicket[]
  reminders         ScreeningReminder[]
  policyAcceptances PolicyAcceptance[]
}

model PolicyAcceptance {
  id         String   @id @default(cuid())
  userId     String
  version    String   @db.VarChar(32)
  acceptedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model AuthToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  kind      String
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

model RealtimeTicket {
  tokenHash   String   @id
  userId      String
  authVersion Int
  expiresAt   DateTime
  region      String   @default("US") @db.VarChar(2)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Profile {
  userId              String    @id
  username            String    @unique
  biography           String    @default("")
  birthDate           DateTime?
  publicProfile       Boolean   @default(false)
  showActivity        Boolean   @default(false)
  allowFriendRequests Boolean   @default(false)
  favoriteMovieIds    String[]  @default([])
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Movie {
  id               String         @id
  title            String
  synopsis         String         @db.Text
  year             Int
  durationSeconds  Int
  genres           String[]
  cast             String[]
  poster           String
  backdrop         String
  color            String         @default("#d9e4c8")
  rating           String         @default("13+")
  minAge           Int            @default(13)
  metadataProvider String         @default("curated")
  metadataSource   String
  trailerUrl       String?
  createdAt        DateTime       @default(now())
  sources          MediaSource[]
  watchlists       Watchlist[]
  history          WatchHistory[]
  rooms            CinemaRoom[]

  @@index([title])
  @@index([createdAt])
  @@index([createdAt, id])
}

model MediaSource {
  id          String    @id @default(cuid())
  movieId     String
  url         String
  format      String    @default("mp4")
  subtitleUrl String?
  license     String
  rightsUrl   String
  attribution String
  authorized  Boolean   @default(false)
  enabled     Boolean   @default(false)
  regions     String[]  @default([])
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  movie       Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  subtitles   SubtitleTrack[]

  @@index([movieId, enabled])
}

model SubtitleTrack {
  id            String @id @default(cuid())
  mediaSourceId String
  language      String @db.VarChar(35)
  label         String @db.VarChar(80)
  url           String
  mediaSource   MediaSource @relation(fields: [mediaSourceId], references: [id], onDelete: Cascade)

  @@unique([mediaSourceId, language])
}

model Watchlist {
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId, createdAt])
}

model WatchHistory {
  userId    String
  movieId   String
  position  Float    @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId, updatedAt])
}

model CinemaRoom {
  id                String              @id @default(cuid())
  title             String
  description       String              @default("")
  visibility        Visibility          @default(PUBLIC)
  hostId            String
  movieId           String
  capacity          Int                 @default(8)
  accessCodeHash    String?
  scheduledAt       DateTime?
  endedAt           DateTime?
  playing           Boolean             @default(false)
  position          Float               @default(0)
  playbackUpdatedAt DateTime            @default(now())
  playbackVersion   Int                 @default(0)
  theme             String              @default("silver")
  createdAt         DateTime            @default(now())
  host              User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  movie             Movie               @relation(fields: [movieId], references: [id])
  memberships       RoomMembership[]
  invitations       Invitation[]
  messages          ChatMessage[]
  reactions         Reaction[]
  reports           Report[]
  reminders         ScreeningReminder[]

  @@index([visibility, endedAt, scheduledAt])
  @@index([hostId])
}

model RoomMembership {
  roomId     String
  userId     String
  role       MembershipRole   @default(MEMBER)
  status     MembershipStatus @default(ACTIVE)
  mutedUntil DateTime?
  joinedAt   DateTime         @default(now())
  lastSeenAt DateTime         @default(now())
  invitationId String?
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  room       CinemaRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([roomId, status])
  @@index([roomId, status, lastSeenAt])
  @@index([userId, status])
  @@index([invitationId])
}

model Invitation {
  id          String     @id @default(cuid())
  roomId      String
  createdById String
  tokenHash   String     @unique
  expiresAt   DateTime
  maxUses     Int        @default(1)
  uses        Int        @default(0)
  revoked     Boolean    @default(false)
  room        CinemaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  memberships RoomMembership[]

  @@index([roomId, expiresAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  roomId    String
  userId    String
  body      String     @db.VarChar(1000)
  clientNonce String?  @db.Uuid
  deleted   Boolean    @default(false)
  createdAt DateTime   @default(now())
  room      CinemaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  reports   Report[]

  @@index([roomId, createdAt])
  @@unique([roomId, userId, clientNonce])
}

model Reaction {
  id        String       @id @default(cuid())
  roomId    String
  userId    String
  messageId String?
  emoji     String
  createdAt DateTime     @default(now())
  room      CinemaRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@index([messageId, createdAt])
  @@index([roomId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  sender     User             @relation("Sent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User             @relation("Received", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Block {
  blockerId String
  blockedId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model MovieClub {
  id          String           @id @default(cuid())
  name        String           @unique
  description String
  genre       String
  color       String           @default("#d9e4c8")
  creatorId   String
  createdAt   DateTime         @default(now())
  creator     User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  memberships ClubMembership[]
}

model ClubMembership {
  clubId   String
  userId   String
  joinedAt DateTime  @default(now())
  club     MovieClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
}

model ScreeningReminder {
  roomId String
  userId String
  sentAt DateTime?
  room   CinemaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([sentAt, roomId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  actorId   String?
  type      String
  title     String
  href      String
  readAt    DateTime?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([actorId])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  roomId     String?
  messageId  String?
  reason     String
  details    String       @default("")
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  room       CinemaRoom?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  message    ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model ModerationAction {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  action    String
  reason    String
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([targetId, createdAt])
}

model Subscription {
  userId               String    @id
  plan                 String    @default("FREE")
  status               String    @default("active")
  customerId           String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  providerPaymentId String   @unique
  amount            Int
  currency          String
  status            String
  receiptUrl        String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PaymentEvent {
  id          String   @id
  processedAt DateTime @default(now())
}
